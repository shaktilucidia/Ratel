{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog":
  {
    "Using":
    [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel":
    {
      "Default": "Information",
      "Override":
      {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo":
    [
      {
        "Name": "Console",
        "Args":
        {
          "formatter":
          "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich":
    [
      "FromLogContext",
      "WithSpan"
    ]
  },

  "AllowedHosts": "*",

  "ConnectionStrings":
  {
    "MainConnection": ""
  },

  "TempoSettings":
  {
    "Uri": "http://tempo.ratel-monitoring.svc.cluster.local:4317"
  },
  
  "AdministratorAccountSettings":
  {
    "Login": "",
    "Password": ""
  },

  "AccessTokensSettings":
  {
    "PrivateKeyId": "",
    "PrivateKey": ""
  },

  "ReverseProxiesSettings":
  {
    "TrustedPodsNetworks": [
    ]
  }
}
